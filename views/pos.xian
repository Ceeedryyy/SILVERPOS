<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>POS - Sales Terminal</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="stylesheet" href="/style.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap');

        .font-main {
            font-family: 'Inter', sans-serif;
        }

        .custom-scroll::-webkit-scrollbar {
            width: 5px;
        }

        .custom-scroll::-webkit-scrollbar-thumb {
            background: #0a4d34;
            border-radius: 10px;
        }
    </style>
</head>

<body class="bg-[#f8fafc] font-main flex overflow-hidden h-screen text-gray-800">

    <main class="flex-1 flex flex-col h-full overflow-hidden">

        <!-- HEADER -->
        <header class="bg-white px-4 md:px-8 py-4 flex flex-col
                       md:flex-row justify-between items-start
                       md:items-center border-b border-gray-100
                       gap-4">

            <div class="flex flex-col md:flex-row items-start
                        md:items-center gap-4">

                <h2 class="text-lg md:text-xl font-black
                           text-gray-800 tracking-tight uppercase">
                    Sales Terminal
                </h2>

                <span class="bg-emerald-100 text-emerald-700
                             text-[10px] font-black px-2 py-1
                             rounded-md uppercase">
                    Station 01
                </span>


            </div>


            <div class="flex items-center gap-4">

                <p class="text-xs font-bold text-gray-400 hidden md:block">
                    Sales Terminal
                </p>

                <div class="border-l pl-4">

                    <div class="text-right">

                        <p class="text-sm font-bold text-gray-800">
                            POS Cashier
                        </p>

                        <p class="text-[10px] text-emerald-600
                                  uppercase font-black">
                            Cashier
                        </p>

                    </div>

                </div>

            </div>

        </header>


        <!-- MAIN CONTENT -->
        <div class="flex flex-col lg:flex-row flex-1
                    overflow-hidden p-4 md:p-6 gap-4 md:gap-6">


            <!-- LEFT SIDE -->
            <div class="flex-1 lg:flex-[3] flex flex-col gap-6">

                <!-- SEARCH -->
                <div class="relative group">

                    <i class="fa-solid fa-magnifying-glass
                              absolute left-5 top-1/2
                              -translate-y-1/2
                              text-gray-400"></i>

                    <input id="sales-search" type="search"
                           placeholder="Search sales or scan barcode..."
                           autocomplete="off"

                           class="w-full pl-14 pr-6 py-4
                                  rounded-2xl bg-white
                                  border-none shadow-sm
                                  focus:ring-2
                                  focus:ring-emerald-600
                                  text-sm font-medium">

                </div>


                <!-- TRANSACTIONS -->
                <div class="bg-white rounded-3xl shadow-sm
                            border border-gray-100 overflow-hidden
                            flex-1">

                    <div class="px-4 md:px-6 py-5
                                border-b border-gray-100
                                flex flex-col xl:flex-row
                                justify-between gap-4">

                        <div>

                            <h3 id="results-title" class="text-lg font-black
                                       text-gray-800">
                                All Transactions
                            </h3>

                            <p id="sales-summary" class="text-xs text-gray-500">
                                No transaction data available.
                            </p>

                        </div>


                        <div class="flex items-center gap-3">

                            <input id="sales-date" type="date"
                                   class="px-3 py-2 bg-slate-50
                                          border border-slate-200
                                          rounded-xl text-xs
                                          font-bold">

                            <span class="text-xs font-black
                                         uppercase
                                         tracking-[0.2em]
                                         text-emerald-700">
                                <span id="today-total">Total: ₱0.00</span>
                            </span>

                        </div>

                    </div>


                    <!-- EMPTY TABLE -->
                    <div class="overflow-x-auto
                                overflow-y-auto
                                max-h-[500px]">

                        <table class="w-full min-w-[600px] text-left">

                            <thead class="bg-slate-50
                                          text-[10px]
                                          text-slate-500
                                          uppercase
                                          tracking-[0.2em]">

                                <tr id="results-columns">

                                    <th class="p-4">
                                        Sales ID
                                    </th>

                                    <th class="p-4">
                                        Date
                                    </th>

                                    <th class="p-4">
                                        Customer
                                    </th>

                                    <th class="p-4 text-right">
                                        Total
                                    </th>

                                    <th class="p-4">
                                        Status
                                    </th>

                                    <th class="p-4 text-right">
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <tbody id="sales-rows">

                                <tr>

                                    <td colspan="6"
                                        class="p-12 text-center">

                                        <div class="flex flex-col
                                                    items-center
                                                    justify-center
                                                    text-gray-300">

                                            <i class="fa-solid
                                                      fa-receipt
                                                      text-5xl mb-4"></i>

                                            <p class="text-sm
                                                      font-black
                                                      uppercase">

                                                No transactions
                                                available
                                            </p>

                                            <p class="text-xs
                                                      mt-2
                                                      text-gray-400">

                                                Completed sales
                                                will appear here.
                                            </p>

                                        </div>

                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>


                    <!-- PAGINATION -->
                    <div class="px-4 md:px-6 py-4
                                border-t border-gray-100
                                flex justify-between
                                items-center text-xs
                                font-black text-slate-500">

                        <span>
                            No transactions
                        </span>

                        <div class="flex gap-3">

                            <button id="previous-page" disabled
                                class="px-3 py-2 rounded-xl
                                       border border-gray-200
                                       opacity-50">

                                Previous
                            </button>

                            <button id="next-page" disabled
                                class="px-3 py-2 rounded-xl
                                       border border-gray-200
                                       opacity-50">

                                Next
                            </button>

                        </div>

                    </div>

                </div>

            </div>


            <!-- CART -->
            <div class="w-full lg:w-96 bg-white
                        rounded-[2.5rem] shadow-2xl
                        flex flex-col overflow-hidden
                        border border-gray-100">

                <!-- CART HEADER -->
                <div class="p-6 md:p-8 border-b
                            border-gray-50 flex
                            justify-between items-center">

                    <div>

                        <h3 class="font-black text-gray-800
                                   text-xl tracking-tight">
                            Cart
                        </h3>

                        <p id="item-count"
                           class="text-[10px] text-gray-400
                                  font-black uppercase mt-1">

                            0 Items added
                        </p>

                    </div>


                    <button onclick="clearCart()"
                            class="w-10 h-10 rounded-xl
                                   bg-red-50 text-red-400
                                   hover:bg-red-500
                                   hover:text-white
                                   flex items-center
                                   justify-center">

                        <i class="fa-solid fa-trash-can"></i>

                    </button>

                </div>


                <!-- EMPTY CART -->
                <div id="cart-items"
                     class="flex-1 overflow-y-auto
                            p-6 md:p-8 custom-scroll">

                    <div class="h-full flex flex-col
                                items-center justify-center
                                text-gray-200 space-y-4">

                        <i class="fa-solid fa-cart-shopping
                                  text-6xl"></i>

                        <p class="text-[10px] font-black
                                  uppercase tracking-widest">

                            Select items to begin
                        </p>

                    </div>

                </div>


                <!-- CART FOOTER -->
                <div class="p-6 md:p-8 bg-gray-50/50
                            space-y-4 border-t">

                    <div class="flex justify-between
                                text-xs font-bold">

                        <span class="text-gray-400 uppercase">
                            Subtotal
                        </span>

                        <span id="subtotal"
                              class="text-gray-700 font-mono">
                            ₱0.00
                        </span>

                    </div>


                    <div class="flex justify-between
                                text-xs font-bold">

                        <span class="text-gray-400 uppercase">
                            Service Tax (0%)
                        </span>

                        <span class="text-gray-700 font-mono">
                            ₱0.00
                        </span>

                    </div>


                    <!-- TOTAL -->
                    <div class="bg-emerald-800 p-5
                                rounded-3xl flex
                                justify-between
                                items-center shadow-xl">

                        <span class="text-white/60
                                     font-black uppercase
                                     text-[10px]">

                            Grand Total
                        </span>

                        <span id="total-amount"
                              class="text-2xl font-black
                                     text-white font-mono">

                            ₱0.00
                        </span>

                    </div>


                    <!-- PAYMENT -->
                    <button onclick="handleCheckout()"
                            class="w-full bg-white
                                   border-2 border-emerald-800
                                   text-emerald-800 py-4
                                   rounded-2xl font-black
                                   text-sm hover:bg-emerald-800
                                   hover:text-white
                                   transition-all">

                        PROCESS PAYMENT

                        <i class="fa-solid
                                  fa-chevron-right ml-2"></i>

                    </button>

                </div>

            </div>

        </div>

    </main>


    <!-- PAYMENT MODAL -->
    <div id="paymentModal"
         class="fixed inset-0 bg-black/50 hidden
                z-[70] flex items-center
                justify-center backdrop-blur-sm p-4">

        <div class="bg-white w-full max-w-lg
                    rounded-2xl shadow-2xl overflow-hidden">

            <div class="px-8 py-6 border-b
                        flex justify-between items-center">

                <div>

                    <h3 class="text-xl font-black
                               uppercase">
                        Process Payment
                    </h3>

                    <p class="text-[10px]
                              text-emerald-600
                              font-black uppercase">
                        Cash amount, discount, and change
                    </p>

                </div>

                <button onclick="closePaymentModal()">

                    <i class="fa-solid fa-xmark
                              text-xl text-gray-400"></i>

                </button>

            </div>


            <div class="p-8 space-y-5">

                <div class="grid grid-cols-2 gap-3">

                    <div class="bg-gray-50
                                rounded-xl p-4">

                        <p class="text-[10px]
                                  text-gray-400
                                  font-black uppercase">
                            Subtotal
                        </p>

                        <p id="pay-subtotal"
                           class="text-xl font-black
                                  font-mono">
                            ₱0.00
                        </p>

                    </div>


                    <div class="bg-gray-50
                                rounded-xl p-4">

                        <p class="text-[10px]
                                  text-gray-400
                                  font-black uppercase">
                            Discount
                        </p>

                        <p id="pay-discount"
                           class="text-xl font-black
                                  text-red-500 font-mono">
                            ₱0.00
                        </p>

                    </div>

                </div>


                <div>

                    <label class="text-xs font-black
                                  uppercase">
                        Discount Type
                    </label>

                    <select id="discountType"
                            class="w-full mt-2 p-3
                                   rounded-xl border">

                        <option value="none">
                            No Discount
                        </option>

                        <option value="pwd">
                            PWD Discount (20%)
                        </option>

                        <option value="senior">
                            Senior Citizen Discount (20%)
                        </option>

                    </select>

                </div>
                <div>
                    <label class="text-xs font-black uppercase">Payment Method</label>

                    <select id="paymentMethod"
                            class="w-full mt-2 p-3 rounded-xl border">
                        <option value="cash">Cash</option>
                        <option value="qrph">QR Ph (GCash, Maya, Supported Banks)</option>
                    </select>
                </div>


                <div id="cashPaymentFields">
                <div>

                    <label class="text-xs font-black
                                  uppercase">
                        Amount Paid
                    </label>

                    <input type="number"
                           id="paymentAmount"
                           placeholder="0.00"
                           class="w-full mt-2 p-4
                                  rounded-xl border-2
                                  border-emerald-700">

                </div>
                </div>
                <!-- DYNAMIC QR PAYMENT -->
                <div id="walletPaymentFields" class="hidden space-y-4">

                    <div class="text-center">
                        <h4 class="text-sm font-black uppercase text-gray-800">
                            Scan to Pay
                        </h4>

                        <p class="text-xs text-gray-500 mt-1">
                            Scan using GCash, Maya, or a supported banking app.
                        </p>
                    </div>

                    <div class="rounded-2xl border-2 border-dashed
                                border-emerald-200 bg-emerald-50 p-5 text-center">

                        <p class="text-xs font-bold uppercase text-gray-500">
                            Exact Amount Due
                        </p>

                        <p id="qrPaymentAmount"
                        class="mt-2 text-3xl font-black text-emerald-800">
                            ₱0.00
                        </p>

                        <div id="qrPaymentPlaceholder"
                            class="mx-auto mt-4 flex h-56 w-56 items-center
                                    justify-center rounded-xl bg-white p-4">

                            <div class="text-center text-gray-400">
                                <i class="fa-solid fa-qrcode text-5xl"></i>

                                <p class="mt-3 text-xs">
                                    Generate your payment QR
                                </p>
                            </div>
                        </div>

                        <img id="walletQrImage"
                            alt="Dynamic QR Ph payment code"
                            class="mx-auto mt-4 hidden h-56 w-56 rounded-xl
                                    border bg-white object-contain p-2">

                        <p id="walletQrStatus"
                        class="mt-4 text-xs font-bold text-amber-700">
                            Waiting for QR generation
                        </p>
                    </div>

                    <button type="button"
                            id="generateWalletQrButton"
                            onclick="generateWalletQr()"
                            class="w-full rounded-xl bg-emerald-800 px-4 py-3
                                text-xs font-black uppercase text-white
                                hover:bg-emerald-900">

                        <i class="fa-solid fa-qrcode mr-2"></i>
                        Generate Payment QR
                    </button>

                    <p class="text-xs leading-5 text-gray-500">
                        Payment must be verified by the payment provider
                        before the transaction can be completed.
                    </p>
                </div>


                <div class="grid grid-cols-2 gap-3">

                    <div class="bg-emerald-800
                                rounded-xl p-4 text-white">

                        <p class="text-[10px]
                                  text-white/60
                                  font-black uppercase">
                            Total Due
                        </p>

                        <p id="pay-total"
                           class="text-2xl font-black font-mono">
                            ₱0.00
                        </p>

                    </div>


                    <div id="changeDisplay" class="bg-gray-900
                                rounded-xl p-4 text-white">

                        <p class="text-[10px]
                                  text-white/60
                                  font-black uppercase">
                            Change
                        </p>

                        <p id="pay-change"
                           class="text-2xl font-black font-mono">
                            ₱0.00
                        </p>

                    </div>

                </div>

            </div>


            <div class="px-8 py-5 bg-gray-50
                        flex justify-end gap-3">

                <button onclick="closePaymentModal()"
                        class="px-5 py-2 border-2
                               border-emerald-800
                               text-emerald-800
                               font-black text-xs
                               rounded-lg uppercase">

                    Cancel
                </button>

                <button id="paymentSubmitButton" onclick="submitPayment()"
                        class="px-5 py-2 bg-emerald-800
                               text-white font-black
                               text-xs rounded-lg
                               uppercase">

                    Done
                </button>

            </div>

        </div>

    </div>


    <div id="voidModal" class="fixed inset-0 hidden z-[80] items-center justify-center bg-black/50 backdrop-blur-sm p-4" role="dialog" aria-modal="true" aria-labelledby="voidTitle">
        <div class="w-full max-w-3xl overflow-hidden rounded-2xl bg-white shadow-2xl">
            <div class="flex items-center justify-between border-b px-8 py-6">
                <h3 id="voidTitle" class="text-xl font-black uppercase text-gray-800">Void Transaction</h3>
                <button onclick="closeVoidModal()" aria-label="Close"><i class="fa-solid fa-xmark text-xl text-gray-400"></i></button>
            </div>
            <div id="voidItems" class="max-h-[55vh] space-y-3 overflow-y-auto p-8"></div>
            <div class="flex justify-end gap-3 border-t px-8 py-5">
                <button onclick="closeVoidModal()" class="rounded-lg border-2 px-5 py-2 text-xs font-black uppercase text-gray-600">Cancel</button>
                <button id="void-entire-button" onclick="voidEntireTransaction()" class="rounded-lg bg-red-600 px-5 py-2 text-xs font-black uppercase text-white hover:bg-red-700">Void Entire Transaction</button>
            </div>
        </div>
    </div>

    <div id="posDialog" class="fixed inset-0 hidden z-[90] items-center justify-center bg-black/50 backdrop-blur-sm p-4" role="dialog" aria-modal="true" aria-labelledby="posDialogTitle">
        <div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-2xl">
            <h3 id="posDialogTitle" class="text-lg font-black text-gray-800">Notice</h3>
            <p id="posDialogMessage" class="mt-3 whitespace-pre-line text-sm text-gray-600"></p>
            <div class="mt-6 flex justify-end gap-3">
                <button id="posDialogCancel" class="hidden rounded-lg border px-4 py-2 text-xs font-black uppercase text-gray-600">Cancel</button>
                <button id="posDialogConfirm" class="rounded-lg bg-emerald-800 px-4 py-2 text-xs font-black uppercase text-white">OK</button>
            </div>
        </div>
    </div>

    <div id="voidConfirmModal" class="fixed inset-0 hidden z-[100] items-center justify-center bg-black/50 backdrop-blur-sm p-4" role="alertdialog" aria-modal="true" aria-labelledby="voidConfirmTitle">
        <div class="w-full max-w-md overflow-hidden rounded-2xl bg-white shadow-2xl">
            <div class="border-b px-6 py-5">
                <h3 id="voidConfirmTitle" class="text-lg font-black uppercase text-gray-800">Confirm Void</h3>
            </div>
            <div class="px-6 py-6">
                <p id="voidConfirmMessage" class="text-sm leading-6 text-gray-600"></p>
            </div>
            <div class="flex justify-end gap-3 border-t bg-gray-50 px-6 py-4">
                <button id="voidConfirmCancel" class="rounded-lg border-2 border-gray-200 px-5 py-2 text-xs font-black uppercase text-gray-600">Cancel</button>
                <button id="voidConfirmAccept" class="rounded-lg bg-red-600 px-5 py-2 text-xs font-black uppercase text-white hover:bg-red-700">Confirm Void</button>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT -->
    <script src="/pos.js?v=20261004-1"></script>

</body>
</html>
